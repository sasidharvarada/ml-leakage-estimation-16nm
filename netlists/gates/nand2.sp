Va a 0 DC 0.000000
Vb b 0 DC 1.000000
Mp1 out a vdd vdd pmos_mod W=6.40000e-08 L=1.60000e-08 AD=2.56000e-15 AS=2.56000e-15 PD=2.08000e-07 PS=2.08000e-07
Mp2 out b vdd vdd pmos_mod W=6.40000e-08 L=1.60000e-08 AD=2.56000e-15 AS=2.56000e-15 PD=2.08000e-07 PS=2.08000e-07
Mn1 out a x 0 nmos_mod W=3.20000e-08 L=1.60000e-08 AD=1.28000e-15 AS=1.28000e-15 PD=1.44000e-07 PS=1.44000e-07
Mn2 x b 0 0 nmos_mod W=3.20000e-08 L=1.60000e-08 AD=1.28000e-15 AS=1.28000e-15 PD=1.44000e-07 PS=1.44000e-07
.nodeset v(x)=0.000000 v(out)=1.000000
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9 itl1=400
.temp 27.0000
.control
set numdgt = 10
op
let ileak = -i(vdd)
echo LEAK $&ileak
let ipin_a = -i(va)
echo PIN_a $&ipin_a
let ipin_b = -i(vb)
echo PIN_b $&ipin_b
echo NODE_out $&v(out)
echo NODE_x $&v(x)
.endc
.end
